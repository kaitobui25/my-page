{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "slug", "title", "status", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string" },
    "slug": { "type": "string" },
    "title": { "type": "string" },
    "status": { "enum": ["draft", "published"] },
    "sourceLanguage": { "const": "vi" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
