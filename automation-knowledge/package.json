{
  "name": "automation-knowledge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --port 5173",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "tsx --test tests/knowledge/audit-regression.test.ts tests/knowledge/storage-export.test.ts",
    "knowledge:validate": "tsx scripts/knowledge/validate-knowledge.ts",
    "knowledge:index": "tsx scripts/knowledge/build-search-index.ts",
    "knowledge:export": "tsx scripts/knowledge/export-knowledge.ts",
    "knowledge:backup": "tsx scripts/knowledge/backup.ts",
    "knowledge:restore": "tsx scripts/knowledge/restore.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.2",
    "konva": "^10.7.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-konva": "19.2.1",
    "tailwind-merge": "3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.35.4",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
