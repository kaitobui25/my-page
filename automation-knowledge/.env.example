# Optional local Cloudflare resource overrides.
# Defaults preserve the existing .wrangler/state resource names.
CLOUDFLARE_D1_DATABASE_NAME=site-creator-d1
CLOUDFLARE_D1_DATABASE_ID=00000000-0000-4000-8000-000000000000
CLOUDFLARE_R2_BUCKET_NAME=site-creator-r2

# Optional knowledge export/backup overrides. Defaults are derived from this project
# and the generated Wrangler config, so these only need to be set when changing policy.
# KNOWLEDGE_DATA_ROOT=C:\path\outside\the\repo\automation-knowledge-data
# KNOWLEDGE_WRANGLER_CONFIG=dist/server/wrangler.json
# KNOWLEDGE_WRANGLER_PERSIST_TO=.wrangler/state
# KNOWLEDGE_D1_DATABASE=DB
# KNOWLEDGE_R2_BUCKET=site-creator-r2
# KNOWLEDGE_CANONICAL_IMAGE_MAX_WIDTH=1920
# KNOWLEDGE_CANONICAL_WEBP_EFFORT=6
# KNOWLEDGE_EXPORT_CONCURRENCY=2
